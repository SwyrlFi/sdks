{
  "name": "sdks",
  "version": "0.0.0",
  "devDependencies": {
    "@babel/runtime": "7.18.9",
    "@changesets/cli": "^2.27.1",
    "@manypkg/cli": "^0.19.2",
    "@types/bs58": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62",
    "eslint": "^7.8.0",
    "eslint-plugin-prettier": "^3.4.1",
    "husky": "^8.0.3",
    "syncpack": "^8.5.14",
    "turbo": "1.10.16"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.12.3",
  "private": true,
  "scripts": {
    "g:check:deps:mismatch": "manypkg check",
    "g:build": "turbo run build",
    "g:lint": "turbo run lint",
    "g:release": "changeset publish",
    "g:test": "turbo run test",
    "g:typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run g:build && changeset publish",
    "postinstall": "node scripts/fix-nested-symlinks.js"
  }
