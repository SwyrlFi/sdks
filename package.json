{
  "name": "sdks",
  "version": "0.0.0",
  "dependencies": {
    "@babel/runtime": "7.18.9",
    "@manypkg/cli": "^0.19.2",
    "@semantic-release/exec": "6.0.3",
    "@typescript-eslint/eslint-plugin": "^5.62",
    "danger": "11.2.6",
    "eslint": "^7.8.0",
    "eslint-plugin-prettier": "^3.4.1",
    "husky": "^8.0.3",
    "semantic-release": "^20.1.0",
    "semantic-release-monorepo": "7.0.5",
    "syncpack": "^8.5.14",
    "turbo": "1.10.16"
  },
  "engines": {
    "node": ">=10",
    "yarn": ">=3.2.3"
  },
  "packageManager": "pnpm@8.15.1",
  "private": true,
  "scripts": {
    "g:check:deps:mismatch": "pnpm manypkg check",
    "g:build": "pnpm turbo run build",
    "g:lint": "pnpm turbo run lint",
    "g:release": "pnpm turbo run release --concurrency=1 --continue",
    "g:test": "pnpm turbo run test",
    "g:typecheck": "pnpm turbo run typecheck",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm g:build && changeset publish",
    "changeset:publish:alpha": "pnpm g:build && changeset publish --tag alpha",
    "changeset:publish:beta": "pnpm g:build && changeset publish --tag beta",
    "changeset:pre:enter:alpha": "changeset pre enter alpha",
    "changeset:pre:enter:beta": "changeset pre enter beta",
    "changeset:pre:exit": "changeset pre exit",
    "publish:interactive": "node scripts/release.js",
    "sdk": "pnpm --filter",
    "postinstall": "husky"
  },
  "workspaces": [
    "sdks/*",
    "sdks/uniswapx-sdk/integration"
  ],
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@types/bs58": "5.0.0",
    "bs58": "6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uniswap/sdks.git"
  }
}
