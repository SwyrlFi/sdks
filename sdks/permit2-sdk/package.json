{
  "name": "@swyrlfi/permit2-sdk",
  "version": "1.0.0-alpha.7",
  "description": "An sdk for interacting with permit2.",
  "repository": "https://github.com/Uniswap/sdks.git",
  "keywords": [
    "uniswap",
    "ethereum"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdx build",
    "interop": "pnpm node writeInterop.js",
    "lint": "prettier --check src/",
    "start": "tsdx watch",
    "test": "tsdx test --testPathIgnorePatterns=/permit2/"
  },
  "dependencies": {
    "ethers": "^5.7.0",
    "tiny-invariant": "^1.1.0"
  },
  "devDependencies": {
    "@types/jest": "^24.0.25",
    "prettier": "^2.4.1",
    "tsdx": "^0.14.1"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true
  },
  "publishConfig": {
    "access": "public"
